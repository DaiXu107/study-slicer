{
  "name": "study-slicer",
  "private": true,
  "version": "1.7.0",
  "description": "把 PhD / 硕士课题拆成每日 45 分钟小任务的本地优先学习工具",
  "author": "DaiXu107",
  "license": "MIT",
  "homepage": "https://github.com/DaiXu107/study-slicer",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaiXu107/study-slicer.git"
  },
  "keywords": [
    "research",
    "phd",
    "productivity",
    "react",
    "typescript",
    "tailwindcss",
    "vite",
    "openalex"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsc --noEmit && vite build --mode electron",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron:renderer": "bun scripts/build-electron.mjs",
    "electron:dev": "bun run build:electron && bun run electron:renderer && electron .",
    "electron:build": "bun run build:electron && bun run electron:renderer && electron-builder --win nsis"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.daixu107.studyslicer",
    "productName": "Study Slicer",
    "copyright": "Copyright © 2026 DaiXu107",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "StudySlicer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Study Slicer",
      "uninstallDisplayName": "Study Slicer ${version}",
      "deleteAppDataOnUninstall": false
    }
  }
}
